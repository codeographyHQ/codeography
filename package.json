{
  "name": "codeography",
  "displayName": "Codeography",
  "description": "Turn your coding sessions into cinematic, narrative-driven stories. You code. Codeography tells the story.",
  "version": "0.1.12",
  "engines": {
    "vscode": "^1.115.0"
  },
  "categories": [
    "Other",
    "Visualization"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onUri"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "codeography.setApiKey",
        "title": "Codeography: Set API Key"
      }
    ],
    "configuration": {
      "title": "Codeography",
      "properties": {
        "codeography.includeCommitSha": {
          "type": "boolean",
          "default": false,
          "description": "Include the short (7-character) SHA in commit events. Off by default: a SHA can identify a public repository.",
          "scope": "application"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test",
    "test:unit": "npm run compile && node --test out/test/unit/core.test.js"
  },
  "devDependencies": {
    "@types/vscode": "^1.115.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "typescript-eslint": "^8.56.1",
    "eslint": "^9.39.3",
    "typescript": "^5.9.3",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2"
  },
  "overrides": {
    "mocha": {
      "diff": "8.0.3",
      "serialize-javascript": "7.1.3"
    }
  },
  "publisher": "codeographyHQ",
  "keywords": [
    "portfolio",
    "proof of work",
    "coding stats",
    "developer story",
    "productivity",
    "git",
    "narrative"
  ],
  "icon": "icon.png",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/codeographyHQ/codeography"
  },
  "bugs": {
    "url": "https://github.com/codeographyHQ/codeography/issues"
  },
  "homepage": "https://codeography.dev",
  "galleryBanner": {
    "color": "#0C0B0A",
    "theme": "dark"
  }
}
