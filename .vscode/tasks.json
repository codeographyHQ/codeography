// See https://go.microsoft.com/fwlink/?LinkId=733558
// for the documentation about the tasks.json format
{
	"version": "2.0.0",
	"tasks": [
		{
			"type": "npm",
			"script": "watch",
			"problemMatcher": "$tsc-watch",
			"isBackground": true,
			"presentation": {
				"reveal": "never"
			},
			"group": {
				"kind": "build",
				"isDefault": true
			}
		},
		{
			"label": "compile (staging API)",
			"type": "shell",
			"command": "npm run compile",
			"options": {
				"env": { "CODEOGRAPHY_API_URL": "https://codeography-api-staging.codeography.workers.dev" }
			},
			"problemMatcher": "$tsc",
			"presentation": { "reveal": "silent" }
		}
	]
}
