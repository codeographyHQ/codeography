// A launch configuration that compiles the extension and then opens it inside a new window
// Use IntelliSense to learn about possible attributes.
// Hover to view descriptions of existing attributes.
// For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
{
	"version": "0.2.0",
	"configurations": [
		{
			"name": "Run Extension",
			"type": "extensionHost",
			"request": "launch",
			"args": [
				"--extensionDevelopmentPath=${workspaceFolder}"
			],
			"outFiles": [
				"${workspaceFolder}/out/**/*.js"
			],
			"preLaunchTask": "${defaultBuildTask}"
		},
		{
			// Talks to the STAGING API in a SEPARATE VS Code process (the 1.115.0
			// test build) with its own user data and extensions folders, so it has
			// its own API key and never sees or overwrites your real one. Not an
			// "extensionHost" launch: that opens the window inside your running
			// VS Code, which ignores --user-data-dir (see scripts/run-staging.mjs).
			// This attaches to the separate host's extension host.
			"name": "Run (staging)",
			"type": "node",
			"request": "attach",
			"port": 9339,
			"continueOnAttach": true,
			"outFiles": [
				"${workspaceFolder}/out/**/*.js"
			],
			"preLaunchTask": "start staging host"
		}
	]
}
